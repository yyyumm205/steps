# Reference handoff, experiment data, and local QA artifacts remain local.
/original/
.local/
/data/
/research-data/
/secrets/
/android/dist/
*.rfbin
*.csv

# Machine configuration and credentials; keep the shareable templates.
.env
.env.*
!.env.example
local.properties
local.properties.*
!local.properties.example
key.properties
keystore.properties
signing.properties
*.jks
*.keystore
*.p12
*.pfx
*.key

# Generated installation packages and diagnostic output.
*.apk
*.aab
*.log
*.hprof
hs_err_pid*
replay_pid*

# Python backend environments, bytecode, and tool caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editor and operating-system temporary files.
.idea/
*.iml
*.swp
*.swo
*.tmp
*.bak
.DS_Store
Thumbs.db
desktop.ini

# Local configuration and generated Android files are also excluded by android/.gitignore.
